file(SIZE "${INPUT}" PATCH_SIZE)
if(PATCH_SIZE EQUAL 0 OR PATCH_SIZE GREATER_EQUAL 4096)
    message(FATAL_ERROR "Adreno patch must fit in one nonempty page")
endif()
file(READ "${INPUT}" PATCH_HEX HEX)
string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1," PATCH_BYTES "${PATCH_HEX}")
get_filename_component(OUTPUT_DIRECTORY "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(WRITE "${OUTPUT}" "/* Generated from bcenabler_patch.s. */\nconst long int PatchRawData_size = ${PATCH_SIZE};\nconst unsigned char PatchRawData[${PATCH_SIZE}] = {${PATCH_BYTES}};\n")
