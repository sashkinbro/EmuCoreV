<?xml version="1.0" encoding="utf-8"?>
<!-- Recommendations only: global defaults -> Game DB -> explicit per-game settings.
     Shared by the Android settings UI and the native core. Never select a driver here. -->
<game-db version="1">
    <profile id="crazy-market-network-modules">
        <!-- HLE network state stalls startup before savedata completion is polled.
             Use the firmware network libraries for this verified title only. -->
        <title-id>PCSE00291</title-id>
        <modules mode="auto-manual">
            <module>libnet</module>
            <module>libnetctl</module>
        </modules>
    </profile>
    <profile id="stealth-inc-depth-clipping">
        <!-- Room covers are moved outside the depth frustum to reveal gameplay.
             Clamping them onto its boundary leaves only the starting capsule visible.
             depth-clamp is a native rasterization compatibility policy. -->
        <title-id>PCSE00280</title-id>
        <gpu depth-clamp="false" />
    </profile>
    <profile id="plants-vs-zombies-thread-order">
        <!-- The loader races sound-manager initialization with unrestricted
             host threads. Guest-priority scheduling preserves startup order. -->
        <title-id>PCSE00064</title-id>
        <gpu accurate-thread-scheduling="true" eager-surface-sync="true" />
    </profile>
</game-db>
